#!/bin/bash
#PBS -P 11003054
#PBS -q normal
#PBS -J 1-51
#PBS -l walltime=06:00:00
#PBS -l select=1:ncpus=8:mem=64GB
#PBS -j oe
#PBS -o /scratch/users/nus/e1327989/fig6_ldwin/logs/
# Figure 6 LD-window GWAS coloc, step 11: recursive clumping of each GWAS file's significant SNPs (P < 1e-5) on PLINK
# --r2 (ALL donors) and the LD partners of every lead among the MAF >= 0.05 panel (option A').
module load miniforge3
eval "$(conda shell.bash hook)"
conda activate /home/users/nus/e1327989/YuhaoDong/miniconda3/envs/normal
W=/scratch/users/nus/e1327989/fig6_ldwin
TR=$(sed -n "${PBS_ARRAY_INDEX}p" $W/traits_51_basenames.txt)
cd $W && Rscript $W/11_clump_nscc.R "$TR" $W/sig $W/out 8 > $W/logs/11_${TR}.log 2>&1
