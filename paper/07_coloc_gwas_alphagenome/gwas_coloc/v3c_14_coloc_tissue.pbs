#!/bin/bash
#PBS -N v3c_14
#PBS -J 1-50
#PBS -l select=1:ncpus=8:mem=24gb
#PBS -l walltime=04:00:00
#PBS -q normal
#PBS -j oe
#PBS -o /projects/group/bliu/e1327989/GTEx/new_GWAS/coloc_final_nogate_v3/coloc_ldunion_20261012/logs/v3c/
# 2026-11-06: v3c rebuild (conditional refit of Brain_Putamen 47842 p0 and Artery_Aorta 38390 p1).
# Same chain as the v3m_* jobs; writes only results_v3c/ and run_v3c/. No host pinning.
umask 022; export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
export PATH="/home/e1327989/.local/share/mamba/envs/gtexfig/bin:$PATH"; export UNITSET=v3c
N=/projects/group/bliu/e1327989/GTEx/new_GWAS/coloc_final_nogate_v3; L=$N/coloc_ldunion_20261012; D=$L/scripts; LG=$L/logs/v3c; RV=$N/results_v3c
TIS=$(sed -n "${PBS_ARRAY_INDEX}p" $N/scripts/tissues_50.txt)
Rscript $D/14_coloc_tissue.R "$TIS" 8 > $LG/14_${TIS}.log 2>&1
