#!/bin/bash
#PBS -N cond_v3c
#PBS -q normal
#PBS -l select=1:ncpus=8:mem=24gb:host=cn02
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o /projects/group/bliu/e1327989/GTEx/QTL_figure/rerun_v2/results/conditional_v3c/logs/cond_v3c.log
# Author 2026-11-06 ("fix"): re-run the conditional analysis of the two units whose stored k2 failed a refit. Writes results/conditional_v3c/.
umask 022
export PATH="/home/e1327989/.local/share/mamba/envs/gtexfig/bin:$PATH" OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
cd /projects/group/bliu/e1327989/GTEx/QTL_figure/rerun_v2
tail -n +2 work/cond_v3c/units_to_run.tsv | cut -f1,2 | sort -u | while read T C; do echo "== $T $C $(date)"; Rscript code/run_conditional_v3c.R freeze $T real $C 8 2>&1 | grep -v -E 'hts_idx|bcfHeader|duplicate keys|older than the data'; done
echo "ALL DONE $(date)"
